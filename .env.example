# Copy to .env and adjust. All settings are optional; defaults shown.

# Binance public market-data endpoint. If you get HTTP 451 (geo-blocked),
# switch to the public data mirror:
#   TADVISOR_BINANCE_BASE_URL=https://data-api.binance.vision
TADVISOR_BINANCE_BASE_URL=https://api.binance.com

# SQLite candle cache location (relative to where you run the tool).
TADVISOR_DB_PATH=data/market.db

# Defaults used when the CLI/API request does not specify them.
TADVISOR_DEFAULT_ACCOUNT_SIZE=10000
TADVISOR_DEFAULT_RISK_PCT=1.0

# Backtest cost model (percent per side).
TADVISOR_FEE_PCT=0.1
TADVISOR_SLIPPAGE_PCT=0.05
